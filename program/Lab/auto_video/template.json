{
  "$schema": "vocab-video/v1",
  "_doc": {
    "videoTem": "選 textTemplate 與 fadeAccu 的 key (e.g. ch-single, ch-single-s)",
    "audioTem": "選 voiceTemplates 的 key (e.g. ch-jp-ch)",
    "fadeAccu.t": "[startSec, inEndSec, stopEndSec, outEndSec] (累加秒數;每個 layer 一列,對應 textTemplate 同 index)",
    "ease": "easeIn | easeOut",
    "isDynamic": "true=從 wordList 對應 col 取值;false=用 text/image 寫死的值"
  },

  "voiceTemplates": {
    "ch-ch":      { "startS": 3.0, "voices": ["ch-F","ch-M"],        "voiceTimes": [6.0, 3.0] },
    "ch-ch-s":    { "startS": 1.8, "voices": ["ch-F","ch-M"],        "voiceTimes": [4.0, 3.0] },
    "ch-jp-ch":   { "startS": 1.5, "voices": ["ch-F","jp-F","ch-M"], "voiceTimes": [3.5, 3.5, 2.5] },
    "ch-jp-ch-s": { "startS": 1.0, "voices": ["ch-F","jp-F"],        "voiceTimes": [2.4, 3.0] }
  },

  "fadeAccu": {
    "jp-single": [
      { "t": [0.4, 1.0, 7.5, 8.0], "ease": "easeOut" },
      { "t": [0.8, 1.4, 7.2, 7.7], "ease": "easeOut" },
      { "t": [1.0, 1.6, 7.0, 7.5], "ease": "easeOut" },
      { "t": [1.4, 2.0, 6.8, 7.3], "ease": "easeOut" },
      { "t": [1.8, 2.4, 6.5, 7.0], "ease": "easeOut" }
    ],
    "ch-single": [
      { "t": [0.6, 1.3, 8.4, 9.0],  "ease": "easeOut" },
      { "t": [1.0, 1.6, 8.0, 8.50], "ease": "easeOut" },
      { "t": [1.0, 1.6, 8.0, 8.50], "ease": "easeOut" },
      { "t": [1.2, 1.8, 8.0, 8.50], "ease": "easeOut" },
      { "t": [1.2, 1.8, 8.0, 8.50], "ease": "easeOut" },
      { "t": [1.4, 2.8, 7.5, 8.00], "ease": "easeOut" },
      { "t": [1.4, 2.8, 7.5, 8.00], "ease": "easeOut" },
      { "t": [1.9, 2.4, 7.0, 7.50], "ease": "easeOut" }
    ],
    "ch-single-s": [
      { "t": [0.5, 1.0, 5.4, 6.0], "ease": "easeOut" },
      { "t": [0.7, 1.1, 5.0, 5.5], "ease": "easeOut" },
      { "t": [0.7, 1.1, 5.0, 5.5], "ease": "easeOut" },
      { "t": [0.8, 1.2, 5.0, 5.5], "ease": "easeOut" },
      { "t": [0.8, 1.2, 5.0, 5.5], "ease": "easeOut" },
      { "t": [1.0, 1.8, 4.5, 5.0], "ease": "easeOut" },
      { "t": [1.0, 1.8, 4.5, 5.0], "ease": "easeOut" }
    ]
  },

